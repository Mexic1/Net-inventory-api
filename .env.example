# Copy to .env and set a password. Never commit .env.
POSTGRES_USER=inventory
POSTGRES_PASSWORD=change-me
POSTGRES_DB=inventory

# DATABASE_URL is assembled from the three values above in compose.yaml.
# Set it directly only when running the app outside compose, e.g.:
#   DATABASE_URL=postgresql+psycopg://inventory:change-me@127.0.0.1:5432/inventory
